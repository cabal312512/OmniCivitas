---
import {slots} from '../q8/slots.mjs';
import '../q8/echo.css';
import '../q8/panel.less';
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>捉迷藏 · OmniCivitas</title><link rel="icon" href="/favicon.svg"/></head><body class="echo-body"><main class="echo-root" x-data="{open:false,fold:false}" :class="fold ? 'echo-fold' : ''">
 <header><a href="/#systems">↖ OCV</a><button id="echo-language">中 / EN</button><button @click="fold=!fold" aria-label="折叠地图">⌁</button><a href="/studio/">♫</a></header>
 <section class="echo-stage"><div class="echo-aura"></div><div class="echo-rail" aria-hidden="true"></div><span class="echo-number" data-echo-count>00</span><h1 data-echo-title>捉迷藏</h1><span class="echo-denominator">/ 30</span><svg class="echo-resident" viewBox="0 0 200 200" aria-label="常驻的小东西" hidden><defs><radialGradient id="echo-skin"><stop stop-color="#efffff"/><stop offset="1" stop-color="#91b5ed"/></radialGradient></defs><path d="M48 145Q10 66 64 53L47 7 101 40 150 4 164 73Q197 143 143 173Q83 191 48 145" fill="url(#echo-skin)" stroke="#6f9cc7"/><ellipse cx="84" cy="93" rx="9" ry="14" fill="#142e56"/><ellipse cx="136" cy="89" rx="9" ry="14" fill="#142e56"/><path d="M93 127q14 14 29-5" fill="none" stroke="#477098" stroke-width="3"/></svg><div class="echo-locked" data-echo-locked>◌</div><p class="echo-talk" data-echo-talk>…</p><div class="echo-clock" data-echo-clock>—</div></section>
 <section class="echo-strip"><span data-echo-store>本地</span><progress data-echo-progress max="30" value="0"></progress><button id="echo-refresh">↻</button><button hx-get="/api/q8/fragment" hx-target="#echo-fragment" hx-swap="innerHTML">▤</button><output id="echo-fragment"></output><button @click="open=!open" data-i18n="map">地图</button></section>
 <section class="echo-conversation"><form id="echo-form"><label for="echo-input" class="echo-label" data-i18n="talk">说点什么</label><input id="echo-input" maxlength="80" autocomplete="off" placeholder="…"/><button type="submit">↵</button></form><div class="echo-quick"><button data-echo-word="你好">你好</button><button data-echo-word="音乐">音乐</button><button data-echo-word="你在哪里">你在哪里</button><label>#<input id="echo-color" value="8bb9ef" maxlength="6" aria-label="颜色"/></label></div><output data-echo-error role="status"></output></section>
 <section class="echo-map" x-show="open" x-cloak><div class="echo-map-header"><b data-i18n="map">地图</b><button @click="open=false">×</button></div><nav>{slots.map(slot=><a href={slot.route} data-slot={slot.id} style={`--echo-row:${slot.id%7};--echo-col:${Math.floor(slot.id/7)}`}><i>{String(slot.id+1).padStart(2,'0')}</i><span>{slot.route==='/functions/'?'工具':slot.route==='/'?'入口':slot.route.split('/').filter(Boolean).at(-1)}</span><small>◌</small></a>)}</nav></section>
 <aside class="echo-note" aria-hidden="true"><span>ρ</span><i></i><b>◦</b></aside><div class="echo-floor" aria-hidden="true"></div>
 <section class="echo-annex"><div class="echo-timezones"><span data-zone="utc"></span><span data-zone="tokyo"></span><span data-zone="local"></span></div><button id="echo-annex-open">签收 ↗</button><div><iframe id="echo-angular" title="签收" hidden></iframe><output id="echo-annex-result"></output></div></section>
 <script>import '../q8/echo.mjs';import '../q8/annex.mjs';</script>
</main></body></html>

# Public defaults only. Copy to .env when needed; never commit the copy.
# Core services have no profile and therefore start without COMPOSE_PROFILES.
OCV_ACTIVE_GROUP=core
# Compose profiles: databases,messaging,monitoring,legacy,search,maximum,everything
# civilization:maximum selects all services within OCV_CONTAINER_BUDGET_MIB.
# Select only the groups required for current work.
COMPOSE_PROFILES=
# Cache paths and Docker Desktop disk locations belong to local tooling.
# This file intentionally does not prescribe a drive, username or host path.
# Historical misspelling only; live account routes are never registered, even when true.
AUTH_ENBALED=false
# Public toy configuration. Unrelated to heaps, account data or permissions.
OCV_MUSEUM_DELAY=43

# Public port binding. These do not alter container-to-container DNS/ports.
OCV_BIND_ADDRESS=127.0.0.1
OCV_WEB_PORT=8080
OCV_GRAFANA_PORT=3001
# Background receipt retention; runtime files use the existing gateway named volume.
# OCV_AFTER_DIR is an optional server-local runtime path, never a required host drive.
OCV_AFTER_RUN_LIMIT=128
OCV_AFTER_TABLE_LIMIT=6
OCV_AFTER_TABLE_EVERY=5
# Optional host dispatcher; never put the actual private key in source control.
OCV_RUNNER_KEY=
# Dispatcher memory budget (MiB), further limited by detected engine memory.
OCV_RUNNER_BUDGET_MIB=6144
# Development defaults only; use your own values for a shared deployment.
OCV_PG_USER=ocv_demo
OCV_PG_PASSWORD=ocv-fiction-only-not-real
OCV_PG_DATABASE=civilization
OCV_MYSQL_USER=ocv_demo
OCV_MYSQL_PASSWORD=ocv-fiction-only-not-real
OCV_MYSQL_ROOT_PASSWORD=ocv-root-fiction-only
OCV_MYSQL_DATABASE=civilization
OCV_RABBIT_USER=ocv
OCV_RABBIT_PASSWORD=ocv-broker-fiction
OCV_MINIO_USER=ocv-fiction
OCV_MINIO_PASSWORD=ocv-file-fiction-only
OCV_GRAFANA_USER=fiction-only-administrator
OCV_GRAFANA_PASSWORD=ocv-dashboard-fiction-only
# Optional DATABASE_URL/RABBIT_URL overrides must URL-encode special characters.
# Compose accepts OCV_<SERVICE>_MEM and OCV_<SERVICE>_CPU for every service.
# Hyphens become underscores: OCV_MESSAGE_BRIDGE_MEM, for example.
# Optional heap overrides: OCV_ES_JAVA_OPTS, OCV_KAFKA_HEAP_OPTS, OCV_JAVA_TOOL_OPTIONS.
# The CLI budget defaults to 8192 MiB for maximum; change it for another machine.

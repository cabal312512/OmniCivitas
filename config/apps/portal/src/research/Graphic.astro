---
import {law,scope,feasible,prefixPreview} from './data.mjs';
const {kind='terminal',id='graphic'}=Astro.props;
const rows=scope.results[0].rows;
const points=(feasible[0]?.feedback??[]).filter(row=>row.metrics?.coverage&&row.metrics?.absOrder);
const nodeMap=new Map(prefixPreview.map(row=>[row.id,row]));
const word=(row)=>row.parent<0?'':word(nodeMap.get(row.parent))+row.action;
const position=row=>{const w=word(row);const n=parseInt(w||'0',2);return {x:38+(n+.5)/2**w.length*824,y:30+(row.depth-1)*54};};
---
<svg class={`research-graphic graphic-${kind}`} viewBox="0 0 900 520" role="img" aria-label={kind==='terminal'?'Exact periodic terminal occupancy patterns':kind==='controllers'?'Properness of the thirteen deterministic one-bit classes':kind==='tree'?'Recorded certificate prefix tree, depth eight excerpt':'Exact feasible coverage, order and attempt-cost projection'}>
 <defs><linearGradient id={`${id}-bg`} x2="1" y2="1"><stop stop-color="#121d2a"/><stop offset="1" stop-color="#070b11"/></linearGradient><radialGradient id={`${id}-glow`}><stop stop-color="#65e0cf" stop-opacity=".3"/><stop offset="1" stop-color="#65e0cf" stop-opacity="0"/></radialGradient><pattern id={`${id}-grid`} width="45" height="45" patternUnits="userSpaceOnUse"><path d="M45 0H0V45" fill="none" stroke="#314457" stroke-width=".5"/></pattern></defs>
 <rect width="900" height="520" fill={`url(#${id}-bg)`}/><rect width="900" height="520" fill={`url(#${id}-grid)`} opacity=".5"/>
 {kind==='terminal'&&<>
  <circle cx="455" cy="257" r="280" fill={`url(#${id}-glow)`}/>
  {law.law.map((atom,i)=><g transform={`translate(${87+i%3*270},${38+Math.floor(i/3)*160})`}>
    {Array.from({length:9},(_,j)=><rect x={j%3*32} y={Math.floor(j/3)*32} width="26" height="26" fill={(Number(atom.key.split(':')[0])>>j)&1?'#76e2ce':'#0a1017'} stroke={(Number(atom.key.split(':')[0])>>j)&1?'#98f3e0':'#344c61'}/>)}
    <text x="111" y="25" fill="#cce1ef" font-size="17" font-family="monospace">{atom.key.split(':')[0]}</text><text x="111" y="49" fill="#698397" font-size="12" font-family="monospace">p = 1/9</text><text x="0" y="113" fill="#647d92" font-size="11" font-family="monospace">N = 4 / H = 1</text>
   </g>)}
  <text x="875" y="498" text-anchor="end" fill="#8ca6b8" font-size="11" font-family="monospace">EXACT OCCUPANCY LAW · PERIODIC 3 × 3</text>
 </>}
 {kind==='controllers'&&<>
  <circle cx="450" cy="250" r="176" fill="none" stroke="#26445b"/><circle cx="450" cy="250" r="127" fill="none" stroke="#223b52" stroke-dasharray="2 7"/>
  {rows.map((row,i)=>{const a=i*Math.PI*2/13-Math.PI/2,x=450+178*Math.cos(a),y=250+178*Math.sin(a);return <g><line x1="450" y1="250" x2={x} y2={y} stroke={row.fixedGeometryProper?'#70dcc658':'#ed6b8b24'}/><circle cx={x} cy={y} r={row.fixedGeometryProper?15:8} fill={row.fixedGeometryProper?'#77e3cc':'#ba5076'}/><text x={x+Math.cos(a)*28} y={y+Math.sin(a)*28+4} text-anchor="middle" fill="#adbfcc" font-family="monospace" font-size="12">F{String(i).padStart(2,'0')}</text></g>;})}
  <text x="450" y="246" text-anchor="middle" fill="#e5f2f5" font-size="45" font-family="sans-serif">13</text><text x="450" y="274" text-anchor="middle" fill="#7793a9" font-size="12" font-family="monospace">STRUCTURAL CLASSES</text>
  <rect x="50" y="466" width="8" height="8" fill="#77e3cc"/><text x="67" y="474" fill="#8da3b4" font-size="12">Fixed-periodic proper</text><rect x="276" y="466" width="8" height="8" fill="#ba5076"/><text x="293" y="474" fill="#8da3b4" font-size="12">Nonproper</text>
 </>}
 {kind==='tree'&&<>
  {prefixPreview.filter(row=>row.parent>=0).map(row=>{const p=position(nodeMap.get(row.parent)),q=position(row);return <path d={`M${p.x} ${p.y} C${p.x} ${p.y+28},${q.x} ${q.y-28},${q.x} ${q.y}`} fill="none" stroke={row.status==='pruned'?'#ea689e':'#59cdbb'} stroke-opacity={.28+Math.max(0,(.72-row.upper))} stroke-width={row.depth<5?1.4:.55}/>;})}
  {prefixPreview.map(row=>{const p=position(row);return <circle cx={p.x} cy={p.y} r={row.depth<5?3.5:1.4} fill={row.status==='pruned'?'#f283ad':'#8aecdb'}/>;})}
  <text x="38" y="486" fill="#94aabd" font-size="12" font-family="monospace">RECORDED PREFIX PARTITION · DEPTH 8 EXCERPT</text><text x="865" y="486" text-anchor="end" fill="#609e98" font-size="12" font-family="monospace">40,001 NODES / FULL CERTIFICATE</text>
 </>}
 {kind==='capability'&&<>
  {points.map(row=>{const m=row.metrics,x=80+(m.coverage.value-.75)/.15*740,y=430-m.absOrder.value*355,c=m.attemptsPerParticle.value;return <circle cx={x} cy={y} r={2.5+Math.min(5,Math.log(1+c))} fill={`hsl(${150+Math.min(130,c*9)} 75% 66%)`} fill-opacity=".6" stroke="#b6def51f"/>;})}
  <path d="M80 35V430H835" fill="none" stroke="#7392a5"/><text x="450" y="486" fill="#94aabc" text-anchor="middle" font-size="13" font-family="monospace">COVERAGE / EXACT FEASIBLE PROJECTION</text><text transform="translate(32,260) rotate(-90)" fill="#94aabc" text-anchor="middle" font-size="12" font-family="monospace">ABSOLUTE ORDER</text><text x="80" y="450" fill="#668699" font-size="12">.75</text><text x="811" y="450" fill="#668699" font-size="12">.90</text><text x="855" y="29" fill="#7799ac" text-anchor="end" font-size="11">COLOUR / ATTEMPT COST · NOT A COMPLETE FRONTIER</text>
 </>}
</svg>

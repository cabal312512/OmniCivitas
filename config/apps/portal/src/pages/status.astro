---
import Fragments from '../q7/1.astro';
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>OmniCivitas · 运行状态</title><link rel="icon" href="/favicon.svg"/></head><body><Fragments/><main><a href="/" aria-label="返回首页">←</a><h1>运行状态</h1><button id="refresh" aria-label="刷新运行状态">↻</button><pre id="status" aria-live="polite">…</pre></main><script>import {ensureCivilizationMeasurement} from "../../../../../pinia/p.mjs";ensureCivilizationMeasurement();const button=document.querySelector<HTMLButtonElement>('#refresh')!;const output=document.querySelector<HTMLPreElement>('#status')!;async function refresh(){button.disabled=true;try{const response=await fetch('/api/system-status.do',{signal:AbortSignal.timeout(6000)});if(!response.ok)throw new Error(`HTTP ${response.status}`);output.textContent=JSON.stringify(await response.json(),null,2);}catch(error){output.textContent='暂不可用：'+(error as Error).message;}finally{button.disabled=false;}}button.addEventListener('click',refresh);refresh();</script><style>body{margin:0;background:radial-gradient(ellipse at 70% 0,#e7f3fb,transparent 65%),#f8fbfd;color:#56738e;font-family:Arial,sans-serif}main{max-width:950px;margin:60px auto;padding:30px;position:relative}h1{font-size:30px;font-weight:400;letter-spacing:-1px;margin:40px 0}a{text-decoration:none;font-size:25px;color:#6a8da8}button{position:absolute;right:35px;top:99px;width:43px;height:43px;border:1px solid #aac7db;border-radius:50%;background:#fff8;font-size:25px;color:#6d96b5;cursor:pointer}pre{white-space:pre-wrap;overflow-wrap:anywhere;padding:30px;border:1px solid #bbd4e57a;background:#ffffffa6;border-radius:20px;box-shadow:0 20px 50px #789fc414;font:12px/1.8 monospace;min-height:180px}button:focus-visible,a:focus-visible{outline:2px solid #77a2c3;outline-offset:5px}@media(max-width:600px){main{margin:20px auto;padding:25px}pre{padding:20px;font-size:10px}button{top:90px}}</style></body></html>

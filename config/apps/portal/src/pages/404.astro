---
import Fragments from '../q7/1.astro';
import Identity from '../aaa/Identity.astro';
import '../report/2.css';
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>404 · OmniCivitas</title><link rel="icon" href="/favicon.svg"/></head><body class="incident-page" data-incident="404"><Fragments/><header class="incident-head"><Identity id="not-found" compact/><h1>404</h1></header><main class="incident-workfloor"><section class="acc-card"><form action="/search/"><input name="q" aria-label="搜索" maxlength="80"/><button>搜索</button></form><a href="/functions/games/">小游戏</a><a href="/functions/calculator/">计算器</a><a href="/functions/">101 个工具</a><a href="/incidents/">事故目录</a><a href="/maze/">迷宫</a><a href="/incidents/achievements/">授勋处</a><label>加数<input id="mini-a" type="number" value="5"/></label><label>另一加数<input id="mini-b" type="number" value="7"/></label><button id="mini-calculate">相加</button><output id="mini-answer"></output></section><section class="acc-card"><h2>井字棋</h2><div id="mini-toe" style="display:grid;grid-template-columns:repeat(3,62px)">{Array.from({length:9},(_,i)=><button data-mini-cell={i} aria-label={`第${i+1}格`}>·</button>)}</div><output id="mini-winner"></output><button id="mini-reset">重开</button></section></main><a class="incident-exit" href="/#systems" aria-label="返回首页" data-incident-exit>↗</a><script>import '../report/report.js';</script></body></html>

---
import Layout from '../q9/Layout.astro';
---
<Layout title="个人主页" kind="profile">
 <section class="q9-profile-card"><div class="q9-profile-banner"></div><img data-profile-avatar src="/favicon.svg" alt="头像"/><label class="q9-upload-avatar">上传头像<input data-avatar-file type="file" accept="image/png,image/jpeg,image/webp"/></label><h1 data-profile-name>guest</h1><p data-profile-intro>—</p><div><a href="/favorites/">收藏夹 ↗</a><a href="/workspace/">工作台</a></div><small data-profile-store>本地</small></section>
 <form class="q9-profile-edit" data-profile-form><header>资料 <button type="submit">保存</button></header><label>昵称<input name="nickname" maxlength="32" autocomplete="off"/></label><label>简介<textarea name="bio" maxlength="500" spellcheck="false"></textarea></label><button type="button" data-avatar-clear>移除头像</button><output data-profile-message role="status"></output></form>
 <section class="q9-contact-card"><header>联系方式 <span>演示</span></header><form data-profile-slip="email" autocomplete="off"><label>更换邮箱<input type="text" data-private="email" maxlength="120" autocomplete="off"/><small data-private-note hidden></small></label><button type="submit">发送验证码</button></form><form data-profile-slip="phone" autocomplete="off"><label>更换手机号<input type="text" data-private="phone" maxlength="40" autocomplete="off"/><small data-private-note hidden></small></label><button type="submit">发送验证码</button></form><small>输入不会发送或保存。</small></section>
 <section class="q9-security-card"><header>安全 <span>演示</span></header><form data-profile-slip="password" autocomplete="off"><label>原密码<input type="password" data-private="old" autocomplete="new-password" maxlength="128"/><small data-private-note hidden></small></label><label>新密码<input type="password" data-private="new" autocomplete="new-password" maxlength="128"/><small data-private-note hidden></small></label><button type="submit">更换密码</button></form><label class="q9-two-factor"><input type="checkbox" data-two-factor/>两步验证</label><button type="button" data-two-factor-code>验证 ↗</button><output data-profile-receipt>—</output></section>
 <aside class="q9-profile-side"><div>リンク</div><a href="/maze/approval/">签收</a><a href="/maze/aside/">侧栏</a><a href="/functions/music-studio/">音乐创作</a><i></i><span>▒ / _</span></aside><output class="q9-status" data-desk-status role="status"></output>
 <script>import '../q9/profile.mjs';</script>
</Layout>

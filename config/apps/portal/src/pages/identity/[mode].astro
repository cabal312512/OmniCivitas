---
import '../../main1/form.css';
export function getStaticPaths(){return ['login','register'].map(mode=>({params:{mode},props:{mode}}));}
const {mode}=Astro.props,create=mode==='login';
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'none'; form-action 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"/>
<meta name="referrer" content="no-referrer"/><title>{create?'创建账户':'欢迎回来'} · OmniCivitas</title><link rel="icon" href="/favicon.svg"/></head>
<body class="fiction-form-page" data-identity-mode={mode}>
 <a href="/#systems" class="form-exit" aria-label="返回主页">↖</a>
 <main class="fiction-card"><h1>{create?'创建账户':'欢迎回来'}</h1><p class="form-subtitle">{create?'创建一个新账号':'登录'}</p><p class="fiction-reminder">虚构身份演示，请勿输入真实密码。</p>
 <noscript><p>需要启用 JavaScript。</p></noscript><form id="fiction-form" autocomplete="off" onsubmit="return false">
  <label for="fiction-email">邮箱 <em>*</em></label><input id="fiction-email" type="email" autocomplete="off" maxlength="120"/>
  <div class="email-meter" aria-hidden="true"><i></i><i></i><i></i><i></i></div><p class="strength-note">邮箱强度：<strong id="email-strength">弱</strong>（请包含大写字母、小写字母、数字、特殊字符）</p>
  <label for="fiction-name">用户昵称 <em>*</em></label><input id="fiction-name" type="text" autocomplete="off" maxlength="80"/><p id="name-occupied" class="field-error"></p>
  <label for="fiction-gender">用户性别 <em>*</em></label><select id="fiction-gender"><option>男</option><option>女</option><option>其他</option></select><p id="gender-occupied" class="field-error"></p>
  <label for="fiction-password">密码 <em>*</em></label><input id="fiction-password" type="password" autocomplete="off" maxlength="120"/><p id="password-occupied" class="field-error"></p>
  <label for="fiction-confirm">确认密码 <em>*</em></label><input id="fiction-confirm" type="password" autocomplete="off" maxlength="120"/><p id="confirm-error" class="field-error"></p>
  <label for="fiction-captcha">验证码 <em>*</em></label><div class="captcha-line"><input id="fiction-captcha" type="text" autocomplete="off" maxlength="8"/><svg class="fiction-captcha" viewBox="0 0 142 52" role="img" aria-label="本站字符验证码"><rect width="142" height="52" fill="#edf2f4"/><path d="M0 18 142 35M8 46 110 0M32 0 130 50M0 31 142 8" stroke="#8daba9"/><text id="captcha-print" x="15" y="37" transform="rotate(-4 70 25)">6Q4X</text><path d="M0 45Q65 1 142 30" fill="none" stroke="#517fb0"/></svg></div><p id="captcha-error" class="field-error"></p>
  <div class="human-check" aria-label="模拟人机验证"><span class="captcha-loader" aria-hidden="true"></span><span id="human-state">正在加载人机验证，请稍候…</span><small>模拟</small></div>
  <p id="identity-error" class="identity-error" aria-live="polite"></p><button id="identity-submit" class="identity-submit" type="button">{create?'注册':'登录'}</button>
 </form>
 <p class="form-bottom">{create?'没有账户？':'已有账户？'} <a href={create?'/identity/register/':'/identity/login/'}>{create?'登录':'注册'}</a></p>
 </main><script>import '../../main1/identity.js';import {ensureCivilizationMeasurement} from '../../../../../../pinia/p.mjs';ensureCivilizationMeasurement();</script>
</body></html>

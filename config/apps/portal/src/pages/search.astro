---
import Fragments from '../q7/1.astro';
import Identity from '../aaa/Identity.astro';
import '../report/2.css';
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>搜索 · OmniCivitas</title><link rel="icon" href="/favicon.svg"/></head><body class="incident-page"><Fragments/><header class="incident-head"><Identity id="search-room" compact/><h1>搜索</h1></header><main class="incident-workfloor"><section class="acc-card"><form action="/search/"><input id="search-query" name="q" aria-label="搜索" maxlength="80"/><button>搜索</button></form><nav id="real-search-results"></nav></section></main><a class="incident-exit" href="/#systems" aria-label="返回首页">↗</a><script>import {searchFeatures} from '../main1/catalogue.mjs';const q=(new URLSearchParams(location.search).get('q')||'').slice(0,80);document.querySelector<HTMLInputElement>('#search-query')!.value=q;const node=document.querySelector('#real-search-results')!;for(const item of searchFeatures(q)){const link=document.createElement('a');link.href=item.url;link.textContent=item.title;node.append(link,document.createElement('br'));}if(!node.childNodes.length)node.textContent='未找到';</script></body></html>

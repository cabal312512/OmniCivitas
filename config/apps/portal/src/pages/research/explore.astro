---
import Layout from '../../research/Layout.astro';
import Accent from '../../research/Accent.astro';
import {prepareResearch,researchData} from '../../research/data.mjs';
await prepareResearch();
---
<Layout title="Interactive research lab" active="explore" wide>
 <section class="page-intro page-intro-visual"><div class="intro-copy"><p class="eyebrow">INTERACTIVE LAB / SIMULATIONS · EXACT LAWS · CERTIFICATES</p><h1>Make the information<br/>constraint tangible.</h1><p>A seeded browser realization, a full stochastic kernel editor and read-only views of the retained exact evidence. Exploratory browser output does not become a new scientific result.</p><nav class="explore-jump" aria-label="Demonstrations"><a href="#adsorption">Adsorption</a><a href="#kernel">Joint kernels</a><a href="#terminal">Terminal law</a><a href="#support">Support witness</a><a href="#prefix">Prefix tree</a></nav></div><Accent kind="explore"/></section>
 <section class="research-section demo-section" id="adsorption"><div class="section-heading"><div><p class="eyebrow">01 / LIVE, SEEDED REALIZATION</p><h2>What changes after a failure?</h2></div><span class="research-tag">EDUCATIONAL SIMULATION</span></div><div class="demo-grid"><div class="demo-display"><canvas data-adsorption-canvas width="900" height="610" aria-label="Live horizontal and vertical rod occupancy"></canvas><div class="demo-display-bar"><span><i class="legend-h"></i>Horizontal</span><span><i class="legend-v"></i>Vertical</span><span data-demo-status>Ready</span></div></div><div class="demo-controls"><label>Control law<select data-demo-policy><option value="feedback">Outcome feedback</option><option value="temporal">Outcome-blind switching</option><option value="iid">IID orientation</option></select></label><div class="controls-row"><label>Lattice<select data-demo-size><option value="24">24 × 24</option><option value="16">16 × 16</option><option value="48">48 × 48</option></select></label><label>Boundary<select data-demo-boundary><option value="periodic">Periodic</option><option value="open">Open</option></select></label></div><label><span data-alpha-label>Flip after success</span><output data-alpha-value>.02</output><input type="range" min="0" max="100" value="2" data-demo-alpha/></label><label><span data-beta-label>Flip after failure</span><output data-beta-value>1.00</output><input type="range" min="0" max="100" value="100" data-demo-beta/></label><label>Seed<input type="number" min="0" max="4294967295" value="20261004" data-demo-seed/></label><div class="demo-buttons"><button type="button" class="research-button primary" data-demo-run>Run ↗</button><button type="button" class="research-button" data-demo-step>Step +100</button><button type="button" class="research-button" data-demo-reset>Reset</button></div><dl class="demo-stats"><div><dt>Coverage</dt><dd data-demo-coverage>0.0000</dd></div><div><dt>Run absolute order</dt><dd data-demo-order>0.0000</dd></div><div><dt>Trials / particle</dt><dd data-demo-cost>0.00</dd></div><div><dt>Proposals</dt><dd data-demo-attempts>0</dd></div></dl><div class="outcome-tape" data-demo-tape aria-label="Recent proposal outcomes"></div><p class="demo-disclaimer">Single realization, not an ensemble estimate. Only geometric jam counts as completion. A nonjammed run stops at 100,000 proposals.</p></div></div></section>
 <section class="research-section demo-section" id="kernel"><div class="section-heading"><div><p class="eyebrow">02 / TWO STATES, JOINT ACTION & NEXT STATE</p><h2>The complete stochastic kernel.</h2></div><a href="/research/read/temporal-null/" class="research-text-link">Read the formal family ↗</a></div><div class="kernel-grid"><div class="kernel-view"><svg viewBox="0 0 700 370" aria-label="Two-state hidden Markov controller"><defs><marker id="kernel-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="m0 0 8 4-8 4" fill="#89d0ba"/></marker></defs><path d="M255 150C310 75 390 75 445 150" fill="none" stroke="#76dac3" stroke-width="2" marker-end="url(#kernel-arrow)"/><path d="M445 218C390 292 310 292 255 218" fill="none" stroke="#ad92f5" stroke-width="2" marker-end="url(#kernel-arrow)"/><path d="M208 138C112 43 103 295 208 223" fill="none" stroke="#516e83" stroke-width="1.5"/><path d="M492 138C588 43 597 295 492 223" fill="none" stroke="#516e83" stroke-width="1.5"/><circle cx="230" cy="180" r="44" fill="#102b2f" stroke="#7cdecc" stroke-width="1.5"/><circle cx="470" cy="180" r="44" fill="#211e35" stroke="#ac93e7" stroke-width="1.5"/><text x="230" y="187" text-anchor="middle" fill="#a9edda" font-size="22">q₀</text><text x="470" y="187" text-anchor="middle" fill="#c2b6ed" font-size="22">q₁</text><text x="350" y="67" text-anchor="middle" fill="#639f9c" font-family="monospace" font-size="12">P(H,q₁) + P(V,q₁)</text><text x="350" y="320" text-anchor="middle" fill="#8a7ab2" font-family="monospace" font-size="12">P(H,q₀) + P(V,q₀)</text><circle data-kernel-indicator cx="230" cy="180" r="53" fill="none" stroke="#bafae2" stroke-dasharray="2 5"/></svg><div class="kernel-word" data-kernel-word aria-label="Sampled orientation word">HVVVHVVVHVVV</div><div class="kernel-matrices"><pre data-kernel-matrix-h></pre><pre data-kernel-matrix-v></pre></div><p class="demo-disclaimer">The row jointly selects a symbol and next state. It never reads adsorption outcomes. Diagram layout is conceptual; the probability matrices are editable.</p></div><div class="demo-controls"><p class="eyebrow">ROW WEIGHTS / NORMALIZED WITHIN EACH STATE</p>{[0,1].map(q=><fieldset class="kernel-row"><legend>From q{q}</legend>{['H → q₀','H → q₁','V → q₀','V → q₁'].map((label,j)=><label>{label}<output data-kernel-value={q*4+j}></output><input type="range" min="0" max="100" value={q===0&&j===1?100:q===1&&j===2?60:q===1&&j===3?40:0} data-kernel-weight={q*4+j}/></label>)}</fieldset>)}<p class="kernel-error" data-kernel-error role="status"></p><button class="research-button primary" data-kernel-sample type="button">Sample a new word ↗</button><label class="word-input">Evaluate P(word)<input type="text" maxlength="18" pattern="[HVhv]*" value="HVVVHV" data-kernel-query spellcheck="false"/></label><output class="word-probability" data-kernel-probability></output></div></div></section>
 <section class="research-section demo-section" id="terminal"><div class="section-heading"><div><p class="eyebrow">03 / EXACT TERMINAL JOINT LAWS</p><h2>Probability has a geometry.</h2></div><span class="research-tag">RETAINED RATIONAL LAW</span></div><div class="demo-grid"><div class="demo-display"><canvas data-terminal-canvas width="1000" height="620" aria-label="Area-weighted mosaic of exact terminal atoms"></canvas><div class="demo-display-bar"><span>Tile area = terminal probability</span><span>Hover or select an atom</span></div></div><div class="demo-controls"><label>Retained policy<select data-terminal-policy><option value="-1">H once, V forever / periodic</option>{researchData.newLaws.map((law,i)=><option value={i}>Rational support witness {i+1} / {law.parameters.boundary}</option>)}</select></label><div class="terminal-selected" data-terminal-preview></div><dl class="demo-stats"><div><dt>Probability</dt><dd data-terminal-p>1/9</dd></div><div><dt>Terminal mask</dt><dd data-terminal-mask>255</dd></div><div><dt>Accepted particles</dt><dd data-terminal-n>4</dd></div><div><dt>Horizontal particles</dt><dd data-terminal-h>1</dd></div></dl><p class="demo-disclaimer">The mosaic is derived from exact stored probabilities. Cell colour shows occupancy, not recovered rod orientation. Multiple atoms may share a mask with different orientation counts.</p><a href="/research/files/stage5/results/certificate-verification.json" class="research-text-link">Download checked support records ↓</a></div></div></section>
 <section class="research-section demo-section" id="support"><div class="section-heading"><div><p class="eyebrow">04 / PERIODIC ALL-DIRECTION WITNESS</p><h2>A mixture without a free bit.</h2></div><a href="/research/read/theorems/" class="research-text-link">Proof & scope ↗</a></div><div class="support-witness"><div class="support-math"><p>J = Eθ − μ E|S| − ν E[A/N]</p><div class="support-comparison"><div><span>F10 / FEEDBACK</span><strong data-reward-f></strong></div><div><span>.9 T₁ + .1 T₂ / HULL WITNESS</span><strong data-reward-mix></strong></div><div><span>BETTER SINGLE CONSTITUENT</span><strong data-reward-best></strong></div></div><div class="support-dominance" data-support-dominance></div><p class="demo-disclaimer">The displayed arithmetic is a floating presentation of retained rational vectors. The all-direction proof uses exact positive slacks. The convex mixture itself is not claimed to fit two states; the better constituent suffices for each linear objective.</p></div><div class="demo-controls"><label>Order penalty μ<output data-support-mu-value>1.00</output><input data-support-mu type="range" min="0" max="200" value="100"/></label><label>Attempt penalty ν<output data-support-nu-value>.12</output><input data-support-nu type="range" min="0" max="60" value="12"/></label><p class="demo-disclaimer">Periodic 3 × 3 dimers only. Fixed properness on both sides. Deterministic one-bit feedback only. This is not an open-boundary or universal-live joint theorem.</p></div></div><details class="certificate-table"><summary>Inspect all eight certified directions <span>+</span></summary><div class="table-scroll"><table><thead><tr><th>Boundary</th><th>μ</th><th>ν</th><th>Certified lower</th><th>Certified upper</th><th>Status</th></tr></thead><tbody>{researchData.support.map(row=><tr><td>{row.boundary}</td><td>{row.mu}</td><td>{row.nu}</td><td>{row.lower.value.toFixed(12)}</td><td>{row.upper.value.toFixed(12)}</td><td>{row.status==='certified-equality'?'Exact density supremum':'Unresolved support interval'}</td></tr>)}</tbody></table></div></details></section>
 <section class="research-section demo-section" id="prefix"><div class="section-heading"><div><p class="eyebrow">05 / A RECORDED WORD-SPACE PARTITION</p><h2>Follow the surviving branches.</h2></div><span class="research-tag">READ-ONLY CERTIFICATE EXCERPT</span></div><div class="demo-grid"><div class="demo-display"><canvas data-prefix-canvas width="1100" height="600" aria-label="Interactive prefix certificate tree"></canvas><div class="demo-display-bar"><span>Teal / expanded or retained</span><span>Rose / pruned</span></div></div><div class="demo-controls"><label>Visible depth<output data-prefix-depth-value>7</output><input data-prefix-depth type="range" min="3" max="8" value="7"/></label><p class="eyebrow">SELECTED PREFIX</p><output class="prefix-word" data-prefix-word>H</output><dl class="demo-stats"><div><dt>Upper bound</dt><dd data-prefix-upper></dd></div><div><dt>Record status</dt><dd data-prefix-status></dd></div><div><dt>Full certificate nodes</dt><dd>40,001</dd></div><div><dt>Recorded max depth</dt><dd>28</dd></div></dl><p class="demo-disclaimer">Only the first eight levels are shown. The full saved partition includes retained, depth and pruned leaves and covers every first-H infinite word; first-V is covered by transposition.</p><a href="/research/code/word/" class="research-text-link">Read the propagation engine ↗</a><a href="/research/library/#downloads" class="research-text-link">Download the full certificates ↓</a></div></div></section>
 <script id="research-demo-data" type="application/json" set:html={JSON.stringify(researchData).replaceAll('<','\u003c')}></script>
</Layout>
<style>
.explore-jump{display:flex;flex-wrap:wrap;gap:24px;margin-top:26px;font:11px var(--r-mono);color:#9dc5b7}.explore-jump a{border-bottom:1px solid #2f544e;padding-bottom:4px}.demo-grid{display:grid;grid-template-columns:1.7fr 1fr;gap:22px}.demo-display{border:1px solid #294253;background:#0a121c;min-width:0;align-self:start}.demo-display canvas{display:block;width:100%;height:auto;aspect-ratio:1.55;background:radial-gradient(ellipse,#142932,#0a131e)}.demo-display-bar{display:flex;align-items:center;gap:20px;border-top:1px solid #294253;padding:14px 18px;font:9px var(--r-mono);color:#6f92a4;flex-wrap:wrap}.demo-display-bar span:last-child{margin-left:auto;color:#99cabd}.demo-display-bar i{display:inline-block;width:6px;height:6px;margin-right:7px}.legend-h{background:#82dfc6}.legend-v{background:#ad95ea}.demo-controls{border:1px solid #293f50;background:#0b1520;padding:24px;display:flex;flex-direction:column;gap:20px;min-width:0}.demo-controls label{font:10px/1.6 var(--r-mono);color:#88a5b6;display:block}.demo-controls label>input:not([type=range]),.demo-controls label>select{display:block;width:100%;margin-top:8px;padding:10px;color:#b7d0d5;background:#111f2d;border:1px solid #2c495a;font:11px var(--r-mono)}.demo-controls input[type=range]{width:100%;display:block;margin:12px 0 0;accent-color:#8ce7d1;height:3px}.demo-controls label output{float:right;color:#a6d9c8}.controls-row{display:grid;grid-template-columns:1fr 1fr;gap:13px}.demo-buttons{display:flex;gap:8px;flex-wrap:wrap}.demo-buttons button{padding:9px 12px;font:10px var(--r-mono);min-height:36px;flex:1;justify-content:center}.demo-stats{display:grid;grid-template-columns:1fr 1fr;margin:0;border-top:1px solid #273d4b;border-left:1px solid #273d4b}.demo-stats>div{padding:15px 12px;border-right:1px solid #273d4b;border-bottom:1px solid #273d4b}.demo-stats dt{font:8px var(--r-mono);color:#5c8296}.demo-stats dd{margin:8px 0 0;font:16px var(--r-mono);color:#b9e1d7;overflow-wrap:anywhere}.demo-disclaimer{font:10px/1.9 var(--r-mono);color:#617f93}.outcome-tape{display:flex;gap:3px;flex-wrap:wrap;min-height:30px}.outcome-tape span{width:11px;height:11px;background:#71c6b1;border-bottom:2px solid #62a898}.outcome-tape span.failure{background:#2e3c50;border-color:#785681}.outcome-tape span[data-direction="1"]{border-color:#af93df}.kernel-grid{display:grid;grid-template-columns:1.55fr 1fr;gap:22px}.kernel-view{border:1px solid #293f50;padding:24px;background:#0b1520}.kernel-view>svg{display:block;width:100%;height:auto}.kernel-word{font:20px var(--r-mono);letter-spacing:.18em;color:#9bc9cc;text-align:center;padding:17px;border-top:1px solid #283f51;border-bottom:1px solid #283f51;overflow-wrap:anywhere}.kernel-matrices{display:grid;grid-template-columns:1fr 1fr;gap:15px}.kernel-matrices pre{font:12px/2 var(--r-mono);color:#92c9c7;background:#102331;padding:18px;border:1px solid #284959;overflow:auto}.kernel-row{border:1px solid #2a4556;padding:16px;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:18px}.kernel-row legend{font:10px var(--r-mono);padding:0 7px;color:#b1d8cd}.kernel-error{font:10px var(--r-mono);color:#eb93b3;min-height:14px}.word-probability{font:20px var(--r-mono);color:#b2dbc8}.terminal-selected{width:111px;height:111px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:4px}.terminal-selected i{border:1px solid #487371;background:#86d5c0}.terminal-selected i.empty{background:#111d2a;border-color:#2f455c}.support-witness{display:grid;grid-template-columns:1.6fr 1fr;gap:22px}.support-math{border:1px solid #2d4a58;background:linear-gradient(135deg,#132c30,#0d1824);padding:29px}.support-math>p:first-child{font:19px/1.7 var(--r-mono);color:#aadfd2}.support-comparison{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin:32px 0}.support-comparison span{font:8px/1.7 var(--r-mono);color:#70919d;display:block}.support-comparison strong{font:22px/2 var(--r-mono);color:#a0e5c9}.support-comparison>div:first-child strong{color:#ae97e1}.support-dominance{border-top:1px solid #305751;border-bottom:1px solid #305751;padding:17px 0;font:13px/1.6 var(--r-mono);color:#b4dec6;margin-bottom:20px}.certificate-table{border:1px solid #2b4155;margin-top:20px}.certificate-table summary{list-style:none;cursor:pointer;padding:18px 22px;font:11px var(--r-mono);color:#8db0b9;display:flex;justify-content:space-between}.certificate-table table{border-collapse:collapse;width:100%;font:10px/1.7 var(--r-mono)}.certificate-table td,.certificate-table th{border-top:1px solid #253e50;padding:13px;text-align:left;white-space:nowrap}.certificate-table th{color:#8dbec3;background:#10212f}.certificate-table td{color:#89a3b5}.table-scroll{overflow:auto}.prefix-word{font:25px/1.6 var(--r-mono);color:#c4e4d7;overflow-wrap:anywhere}.kernel-view .demo-disclaimer{margin-top:25px}
@media(max-width:980px){.demo-grid,.kernel-grid,.support-witness{grid-template-columns:1.4fr 1fr}.demo-controls{padding:18px}.demo-stats dd{font-size:14px}.demo-display-bar{font-size:8px;padding:12px}.support-comparison{grid-template-columns:1fr;gap:8px;margin:22px 0}.support-comparison>div{display:flex;gap:15px;justify-content:space-between;align-items:center}.support-comparison strong{font-size:19px}.kernel-matrices{grid-template-columns:1fr}.kernel-matrices pre{margin:5px 0;font-size:11px}.kernel-word{font-size:15px}.support-math>p:first-child{font-size:15px}}
@media(max-width:700px){.demo-grid,.kernel-grid,.support-witness{grid-template-columns:1fr}.demo-display canvas{aspect-ratio:1.45}.kernel-view{padding:15px}.kernel-matrices{grid-template-columns:1fr 1fr}.kernel-matrices pre{padding:10px;font-size:10px}.support-math{padding:23px}.explore-jump{gap:15px;font-size:9px}.demo-controls{padding:22px}.kernel-word{font-size:17px}.demo-stats dd{font-size:18px}}
</style>

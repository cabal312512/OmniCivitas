---
import Layout from '../../research/Layout.astro';
import Accent from '../../research/Accent.astro';
import {documents,codes,prepareResearch} from '../../research/data.mjs';
const assets=await prepareResearch();
const categories=[...new Set(documents.map(doc=>doc.category))];
---
<Layout title="Research library" active="library">
 <section class="page-intro page-intro-visual"><div class="intro-copy"><p class="eyebrow">THE COMPLETE RECORD / PAPERS · METHODS · SOURCE · EVIDENCE</p><h1>Nothing hidden<br/>behind the result.</h1><p>The unified paper is the main narrative. Detailed methods, exact certificates, archived empirical records and adversarial review remain available in full.</p></div><Accent kind="library"/></section>
 <div class="research-filter" aria-label="Filter documents"><button data-library-filter="all" aria-pressed="true">All documents</button>{categories.map(category=><button data-library-filter={category} aria-pressed="false">{category}</button>)}<output class="research-results-count" data-library-count>{documents.length} documents</output></div>
 <section class="library-grid" aria-label="Research documents">{documents.map((doc,i)=><a class="document-card" data-document-category={doc.category} href={`/research/read/${doc.slug}/`}><span class="eyebrow">{doc.category}</span><h2>{doc.title}</h2><p>{doc.summary}</p><span class="doc-arrow">{String(i+1).padStart(2,'0')} / READ DOCUMENT ↗</span></a>)}</section>
 <section class="research-section"><div class="section-heading"><div><p class="eyebrow">CORE IMPLEMENTATION</p><h2>Read the machinery.</h2></div><a class="research-text-link" href="/research/code/word/">Source reader ↗</a></div><div class="library-grid">{codes.map(code=><a class="document-card" href={`/research/code/${code.slug}/`}><span class="eyebrow">SOURCE MODULE / JAVASCRIPT</span><h2>{code.title}</h2><p>{code.description}</p><span class="doc-arrow">INSPECT SOURCE ↗</span></a>)}</div></section>
 <section class="research-section" id="downloads"><div class="section-heading"><div><p class="eyebrow">IMMUTABLE SNAPSHOT</p><h2>Download the evidence.</h2></div><span class="section-note">{assets.totalFiles.toLocaleString('en-US')} retained files / SHA-256 indexed</span></div><div class="downloads-grid">{assets.archives.map(archive=><article class="download-card"><h3>{archive.title}</h3><p>{archive.description}</p><small>{archive.files.toLocaleString('en-US')} files · {(archive.bytes/1048576).toFixed(1)} MB · TAR.GZ</small><br/><a href={archive.url} download>Download complete collection ↓</a><code>SHA-256 / {archive.sha256}</code></article>)}</div><p class="integrity-note">The packages preserve original bytes and historical paths. The raw and processed records are archived evidence, not newly rerun experiments. Browser demonstrations are educational. No new research extension or PDF was generated for this website.</p><div class="hero-actions"><a class="research-text-link" href="/research/asset-manifest.json" download="research-asset-manifest.json">Download artifact index ↓</a><a class="research-text-link" href="/research/files/stage5/results/certificate-verification.json" download>Download verified supports ↓</a></div></section>
</Layout>

---
import Layout from '../../research/Layout.astro';
import {Code} from 'astro:components';
import Graphic from '../../research/Graphic.astro';
import Dashboard from '../../research/Dashboard.astro';
import {prepareResearch,gallery,documents,readCode,codes} from '../../research/data.mjs';
await prepareResearch();
const featureFigures=[gallery[0],gallery[2],gallery[3],gallery[6]];
const core=readCode(codes[2]);
---
<Layout active="overview" wide compact>
 <section class="research-hero" id="top">
  <div class="hero-coordinate" aria-hidden="true">INFORMATION → CONTROL → GEOMETRY</div>
  <div class="hero-copy"><p class="eyebrow"><span class="signal-dot"></span>OUTCOME-ONLY CONTROL</p><h1>A bit of feedback.<br/>A world of<br/><em>outcomes.</em></h1><p class="hero-summary">Exact laws. Physical memory. Temporal limits.</p><div class="hero-actions"><a class="research-button primary" href="/research/explore/">Interactive lab <span>↗</span></a><a class="research-text-link" href="/research/read/manuscript/">Read the paper ↗</a></div><div class="hero-status"><span class="status-mark">FROZEN EVIDENCE</span><span>L3 / K2 / PERIODIC + OPEN</span></div></div>
  <div class="hero-object" aria-label="Interactive three-dimensional conceptual visualization of an adsorption lattice"><canvas data-research-hero tabindex="0" aria-label="Interactive lattice: move the pointer to illuminate and lift cells; click to send a ripple. The view stays fixed."></canvas><div class="hero-frame-corners" aria-hidden="true"></div><div class="hero-object-label"><span>01 / THE CONTROL FIELD</span><span>CONCEPTUAL VISUAL · MOVE YOUR POINTER</span></div><div class="hero-object-tag"><b>H</b><i>→</i><b>V</b><span>success / failure</span></div></div>
 </section>
 <section class="research-metrics" aria-label="Verified research snapshot"><div><span>Density supremum</span><strong>8<span>/</span>9</strong><small>Exact · both tiny boundaries</small></div><div><span>Operational classes</span><strong>22,077</strong><small>Universal deterministic physical quotient</small></div><div><span>Prefix bounds checked</span><strong>240,006</strong><small>Independent raw-anchor verification</small></div><div><span>Research tests</span><strong>142<span>/</span>142</strong><small>One invocation · zero failures</small></div></section>
 <Dashboard/>
 <section class="research-section" id="findings"><div class="section-heading"><div><p class="eyebrow">01 / THE RESULT</p><h2>Structure is not performance.</h2></div><a class="research-text-link" href="/research/read/theorems/">Theorems & proofs ↗</a></div>
  <div class="findings-grid"><article class="finding finding-lead"><span class="finding-index">01</span><p class="eyebrow">EXACT / SCOPED NEGATIVE</p><h3>Different process.<br/>No better support.</h3><p>Periodic 3 × 3 · proper deterministic one-bit feedback · complete proper two-state temporal family · μ, ν ≥ 0.</p><div class="equation">max<sub>F</sub> J<sub>μ,ν</sub> ≤ sup<sub>T≤2</sub> J<sub>μ,ν</sub></div><a href="/research/read/theorems/">Witness & scope ↗</a></article>
  <article class="finding"><span class="finding-index">02</span><p class="eyebrow">EXACT / DENSITY</p><h3>Eight occupied.<br/>One left open.</h3><Graphic kind="terminal" id="finding-law"/><p>Supremum: 8/9. Open finite attainment unproved.</p><a href="/research/explore/#terminal">Terminal law ↗</a></article>
  <article class="finding"><span class="finding-index">03</span><p class="eyebrow">CERTIFIED / UNRESOLVED</p><h3>The open case<br/>stays open.</h3><div class="gap-range"><span>−0.14885658</span><i></i><b>0</b><i></i><span>+0.00747751</span></div><p>Feedback − temporal support · μ = 1.25, ν = .4.<br/>Crosses zero. Unresolved.</p><a href="/research/explore/#support">Inspect the gap ↗</a></article></div>
 </section>
 <section class="research-section" id="visuals"><div class="section-heading"><div><p class="eyebrow">02 / THE VISUAL RECORD</p><h2>Fields. Networks. Microstructure.</h2></div><a class="research-text-link" href="/research/atlas/">Open the full atlas ↗</a></div><div class="featured-atlas">{featureFigures.map((figure,i)=><a class={`figure-card figure-feature-${i}`} href={`/research/atlas/#figure-${figure.index}`}><div class="figure-image"><img src={figure.src} alt={figure.title} loading="lazy"/></div><div class="figure-caption"><div><span class="eyebrow">{figure.kind}</span><h3>{figure.title}</h3></div><span>↗</span></div></a>)}</div></section>
 <section class="research-section lab-strip" id="lab"><div class="section-heading"><div><p class="eyebrow">03 / HANDS ON</p><h2>Change the rule. Watch the law.</h2></div><span class="section-note">Browser demonstrations are not new experiments.</span></div><div class="lab-grid">
  <a class="lab-card" href="/research/explore/#adsorption"><div class="mini-lattice" aria-hidden="true">{Array.from({length:112},(_,i)=><i class={i%7<3?'mini-h':i%7<5?'mini-v':''}></i>)}</div><div><span class="eyebrow">01 / LIVE ADSORPTION</span><h3>Success. Failure. Memory.</h3><span class="lab-launch">Launch experiment ↗</span></div></a>
  <a class="lab-card" href="/research/explore/#kernel"><Graphic kind="controllers" id="lab-memory"/><div><span class="eyebrow">02 / JOINT KERNELS</span><h3>One bit. A full stochastic null.</h3><span class="lab-launch">Inspect the machine ↗</span></div></a>
  <a class="lab-card" href="/research/explore/#prefix"><Graphic kind="tree" id="lab-tree"/><div><span class="eyebrow">03 / CERTIFICATE TOPOLOGY</span><h3>Every word has a branch.</h3><span class="lab-launch">Traverse the certificate ↗</span></div></a>
 </div></section>
 <section class="research-section methodology" id="method"><div class="section-heading"><div><p class="eyebrow">04 / THE METHOD</p><h2>From observations to a certificate.</h2></div><a href="/research/library/" class="research-text-link">Open the methods collection ↗</a></div><div class="method-grid"><div class="method-flow">{[
  ['01','Define the information channel','Only the previous proposal outcome is observed. Occupancy and legal anchors remain hidden.'],
  ['02','Separate jam from deadlock','A blocked controller is not a jammed geometry. Admissibility uses the complete reachable product chain.'],
  ['03','Match physical memory','Positive histories establish genuine randomized memory lower bounds, rather than source-state counts.'],
  ['04','Cover the complete null','Full joint probability simplexes and unlimited temporal word-law relaxations bound every admissible two-state kernel.'],
  ['05','Verify, retain, stop','Independent rational checks, archived evidence and unresolved intervals survive the final adversarial review.'],
 ].map(([n,title,text])=><details class="method-step"><summary><span>{n}</span><h3>{title}</h3><b>+</b></summary><p>{text}</p></details>)}</div><div class="method-visual"><Graphic kind="capability" id="method-cloud"/><div class="visual-caption"><span>EXACT FEASIBLE OBJECTIVE PROJECTION</span><a href="/research/atlas/">View source figures ↗</a></div><p>Feasible laws / incomplete frontier.</p></div></div></section>
 <section class="research-section code-section" id="code"><div class="section-heading"><div><p class="eyebrow">05 / UNDER THE SURFACE</p><h2>The bound, in code.</h2></div><a class="research-text-link" href="/research/code/word/">Read the complete module ↗</a></div><div class="code-grid"><div class="code-context"><span class="code-language">JAVASCRIPT / BIGINT / RATIONAL TAILS</span><h3>Count anchors.<br/>Keep the stopping time.<br/>Round upwards.</h3><p>Exact multiplicities. Actual jam times. Certified suffix values.</p><a href="/research/code/verify/">Inspect the verifier ↗</a></div><div class="code-window"><div class="code-window-bar"><span>word-bound.mjs</span><button data-copy-target="core-code" type="button">Copy ↗</button></div><Code id="core-code" code={core} lang="javascript" theme="github-dark"/></div></div></section>
 <section class="research-section paper-section" id="paper"><div class="paper-cover"><div class="paper-cover-rule"></div><span class="eyebrow">OCV / RESEARCH PAPER</span><h3>Outcome-only<br/>control of<br/>lattice adsorption</h3><p>Operational memory & certified temporal comparisons</p><span class="paper-cover-id">FINITE SYSTEMS / UNIFIED MANUSCRIPT</span><Graphic kind="tree" id="paper-cover-tree"/></div><div class="paper-pitch"><p class="eyebrow">06 / READ DEEPER</p><h2>A complete record.<br/>Including the limits.</h2><p>20 documents. Six source modules. Complete archived evidence.</p><details class="abstract-preview"><summary>Read the abstract <span>+</span></summary><p>We study irreversible adsorption when a finite-state controller observes only success or failure. Exact tiny-system certificates close a scoped deterministic-one-bit periodic comparison and both density suprema, while the open joint trade-off remains unresolved. Process-law separation does not imply an averaged-objective advantage.</p></details><div class="hero-actions"><a class="research-button primary" href="/research/read/manuscript/">Open the full paper ↗</a><a class="research-text-link" href="/research/library/">Methods, source & evidence ↗</a></div><a class="research-subtle" href="/research/read/review/">Read the hostile review and disclosure ↗</a></div></section>
</Layout>

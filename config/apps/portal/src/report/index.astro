---
const {id}=Astro.props;
---
{id==='intake'&&<><section class="acc-card intake-card"><form id="bad-form"><fieldset id="date-day"><legend>日</legend><select id="day" aria-label="日">{Array.from({length:31},(_,i)=><option value={i+1}>{i+1}</option>)}</select><button type="button" id="choose-day">选年</button></fieldset><fieldset id="date-year" hidden><legend>年</legend><input id="year" type="number" value="2024" min="1900" max="9999" aria-label="年"/><button type="button" id="choose-year">选月</button></fieldset><fieldset id="date-month" hidden><legend>月</legend><select id="month" aria-label="月">{Array.from({length:12},(_,i)=><option value={i+1}>{i+1}</option>)}</select></fieldset><label class="bad-label">数量 <input type="range" id="volume" min="0" max="100" value="43" aria-label="数量"/><output id="volume-text">43</output></label><label>备注 * <input id="optional-note" placeholder="此项非必填" maxlength="160"/></label><small>此项非必填</small><label>内容 <input id="request-text" placeholder="请勿输入" maxlength="160" value="事项"/></label><label>类别 <select id="other-type"><option value="selected">请选择（已选择）</option><option value="other">其他</option><option value="another">另外的其他</option><option value="spelling">其它</option><option value="rest">其余</option><option value="else">另外</option></select></label><label id="other-detail" hidden>其他属于哪种其他 <select><option>临时其他</option><option>长期其他</option></select></label><label><input class="circle-check" type="checkbox"/>核对</label><label><input class="square-radio" type="radio" name="rate" checked/>A</label><label><input class="square-radio" type="radio" name="rate"/>B</label><label>评分<select id="score"><option>2</option><option>3</option><option>4</option><option>5</option></select></label><label>另一评分<select><option>A</option><option>B</option><option>C</option><option>7</option><option>很好</option></select></label><div class="submit-row"><button id="submit-normal">提交</button><button id="submit-application">提交申请</button><button id="submit-quick">快速提交</button><button type="button" id="restore-form">重置</button><button type="button" id="clear-form">清空</button></div></form><pre id="form-result" aria-live="polite"></pre><progress id="form-progress" max="120" value="0"></progress><span id="progress-text"></span><button id="save-normal">保存</button><button id="save-denial">保存但不承认已保存</button><button id="cancel-operation">取消</button><div id="cancel-choice" hidden><button id="cancel-cancel">取消本次取消，继续原操作</button><button id="cancel-original">取消原操作，结束登记</button></div><p id="intake-status"></p><button id="confirm-start">确定不取消本次操作吗？</button><dialog id="confirm-one"><p>确定不取消本次操作吗？</p><button id="answer-no">否</button><button id="answer-yes">是</button><button id="cancel-no">取消否</button></dialog><dialog id="confirm-two"><p>是否确认刚才的否？</p><button id="confirm-no">确定</button><button id="dismiss-no">取消</button></dialog></section><section class="acc-card step-card"><button id="step-next">下一步</button><output id="step-number">1</output><button id="step-previous">上一步</button><div id="step-order"><button id="order-cancel">取消</button><button id="order-confirm">确定</button></div></section><section class="acc-card list-card"><ul><li>日</li><li>年</li><li>月</li></ul><footer>共三项，另有一项为本说明</footer></section></>}
{id==='clipboard'&&<section class="acc-card"><textarea id="licensed-text" aria-label="副本正文" maxlength="10000">复制这句话。Ω\n第二行</textarea><button id="permit-copy">生成复制许可</button><button id="licensed-copy" disabled>复制</button><output id="copy-result"></output><p id="copy-permit"></p></section>}
{id==='hangar'&&<><section class="acc-card"><button id="simulate-hang">不建议点击</button><button id="responsive-counter">计数</button><output id="responsive-count">0</output><span id="no-response" hidden>系统没有响应</span><div id="hang-success" role="status"></div></section><section class="acc-card forever-card"><i class="slow-spinner"></i><p>正在加载 99%</p><progress max="100" value="99"></progress><button id="why-slow">为什么这么慢</button><p id="slow-reason"></p></section><section class="acc-card"><progress id="never-progress" max="100" value="0"></progress><output id="never-output">0%</output><progress id="back-progress" max="100" value="97"></progress><output id="back-output">97%</output></section></>}
{id==='layout'&&<><section class="acc-card uneven-card"><h2 class="drifting-title">窗口登记表</h2><button class="fake-control" data-fake>受理</button><a role="button" tabindex="0" id="decoration-text">···</a><button id="question-help">？</button><aside id="layout-help">关闭帮助</aside><button id="hover-shift">提交至当前尚未确定但仍需确定的受理窗口</button><label class="wrong-label">名称<input value="表头"/></label><table class="misregistered-table"><thead><tr><th>名称</th><th>状态</th></tr></thead><tbody><tr><td>行</td><td>已登记</td></tr></tbody></table><span style="font-size:12px">12</span><span style="font-size:14px">14</span><span style="font-size:15px">15</span><span style="font-size:16px">16</span><span style="font-size:18px">18</span><button id="drop-shift" aria-expanded="false">Dropdown</button><div id="relocated-dropdown" hidden><button>选项</button><button>另一项</button></div><button id="far-tooltip" aria-describedby="distant-tip">说明</button><span id="distant-tip" role="tooltip" hidden>说明在这里</span></section><section class="acc-card notifications-card"><output id="closed-windows">0</output><span id="notification-count">1+</span><span id="unread-count">(0)</span><i id="unread-dot"></i><span id="read-count">3</span><button id="mark-read">全部已读</button><button id="toast-success">成功</button><button id="toast-error">失败</button><button id="toast-middle">提示</button><button id="toast-self-close">可关闭提示</button><button id="open-first">窗口一</button><button id="open-second">窗口二</button><button id="open-third">窗口三</button></section><dialog id="window-first"><button class="close-left" data-close="window-first">×</button><p>窗口一</p><button data-close="window-first">取消</button><button data-close="window-first">确定</button></dialog><dialog id="window-second"><p>窗口二</p><button data-close="window-second">确定</button><button data-close="window-second">取消</button><button class="close-bottom" data-close="window-second">×</button></dialog><dialog id="window-third"><span class="pretend-x" aria-hidden="true">×</span><p>窗口三</p><button class="close-left" data-close="window-third">×</button><button data-close="window-third">取消</button><button data-close="window-third">确定</button></dialog><div id="toast-layer" aria-live="polite"></div><a href="/incidents/" class="module-return">返回</a></>}
{id==='unwise'&&<><section class="acc-card unwise-card"><button id="peek-eye">查看更多</button><svg id="owned-eye" viewBox="0 0 300 180" hidden aria-label="本站虚构眼睛"><path d="M10 90Q150-60 290 90Q150 240 10 90" fill="#fff" stroke="#0347dd" stroke-width="8"/><circle cx="150" cy="90" r="60" fill="#0347dd"/><circle cx="150" cy="90" r="26" fill="#061e54"/></svg><p id="run-text">文字</p><img id="shrinking-image" src="/favicon.svg" alt="标志" width="130" height="130"/><p id="swap-words">今天 明天</p><input id="narrowing-input" aria-label="越写越窄" maxlength="200"/><progress id="mouse-progress" max="100" value="0"></progress><output id="mouse-progress-value">0</output><a id="two-click-link" href="/incidents/table/" title="这是链接">下一页</a><a id="honest-tooltip" href="/incidents/clipboard/" title="这是链接">副本</a><p id="surprise-status"></p><a href="/incidents/settings/">互換モード</a></section></>}
{id==='settings'&&<section class="acc-card"><label>互換モード<input id="compatibility" type="checkbox"/></label><p id="compatibility-detail"></p><label>禁用动画<input id="disable-animation" type="checkbox"/></label><output id="disable-state">OFF：禁用未开启</output><div class="settings-moving-dot"></div><label>字体<select id="font-family"><option value="sans-serif">公文风</option><option value="monospace">电表风</option><option value="serif">会议纪要风</option></select></label><button id="font-size">字号</button><button id="font-everywhere">应用到全部</button><small id="unimportant-size">角落</small><button id="advanced-mode">高级模式</button><button id="simple-mode">简单模式</button><section id="settings-options"><p>字体可在上面选择，字号第一次仅改变角落。</p><label>小选项<input type="checkbox"/></label></section><p id="settings-status"></p></section>}
{id==='table'&&<section class="acc-card"><button id="wrong-sort">排序</button><output id="sort-label">原始</output><ol id="wrong-items"><li data-value="3">三</li><li data-value="1">一</li><li data-value="2">二</li><li class="unloaded-slot" aria-label="空位"></li></ol><nav aria-label="分页"><button id="one-previous">上一页</button><button id="one-next">下一页</button><button id="next-next">第下一页</button></nav><output id="one-page">第 01/1 页</output></section>}
{id==='scroll'&&<><button id="wrong-top">回到顶部</button><section class="acc-card"><div id="inner-scroll" tabindex="0" aria-label="内部滚动区"><p>上</p><div class="scroll-distance"></div><button id="bottom-reachable">底部按钮</button><output id="bottom-clicked"></output></div></section><button id="floating-blocker" class="floating-blocker">拖一下</button><div class="outer-distance"></div></>}
{id==='support'&&<section class="acc-card support-card"><b>在线客服</b><small>自动演示，非人工</small><button id="support-start">连接</button><div id="support-log" aria-live="polite"></div><form id="support-form"><input id="support-message" aria-label="回复" maxlength="200"/><button>发送</button></form></section>}
{id==='telemetry'&&<><section class="acc-card"><h2>所有系统运行正常</h2><ul><li>严重异常：窗口</li><li>严重异常：单位</li><li>严重异常：正常</li></ul><b>健康度 108%</b><p>CPU 3%　压力极高</p><p>内存 MB/s²</p><div class="unit-graph"><i></i><i></i><i></i><i></i></div><small>娱乐面板，非实际监控</small></section><section class="acc-card"><span>在线人数</span><b id="online-count"></b><small>数据仅供精确参考（分钟伪数据）</small><dl><dt>本地</dt><dd id="clock-local"></dd><dt>UTC</dt><dd id="clock-utc"></dd><dt>平台标准时间</dt><dd id="clock-platform"></dd></dl><button id="sync-clock">同步时间</button><output id="clock-offset"></output></section></>}
{id==='uniform'&&<><section class="acc-card"><p>您正在使用统一体验</p><iframe src="/incidents/iframe/" title="统一体验内层" height="160" width="320" sandbox="allow-scripts allow-same-origin"></iframe></section><section class="acc-card internal-ad"><a href="/functions/calculator/" id="ad-x" aria-label="关闭广告">×</a><b>本站计算工具</b><p>功能入口</p><button id="hide-ad">暂时不处理</button></section></>}
{id==='announcements'&&<section class="acc-card announcement-card"><p>本平台已采用 37 类前端技术，可充分保障不确定性</p><p>经过架构升级，页面数量减少了 -4 个。</p><p>目前已解决 104% 的已知问题。</p><p>为提高兼容性，本系统同时保留不兼容版本。</p><p id="reading-line">由于系统性能较高，部分功能可能表现为缓慢。</p><output id="reading-seconds">0 秒</output><p>系统总版本 <output id="fake-version"></output></p><a href="/incidents/tutorial/">即将上线</a><a href="/incidents/retry/">稳定运行</a></section>}
{id==='retry'&&<section class="acc-card error-card"><div id="initial-error"><h2>服务器内部非常外部错误</h2><p id="rotating-error"></p><p id="unchanged-error">错误仍然是这个错误</p><button id="retry-once">重试</button><button id="copy-long-error">复制错误信息</button><output id="error-copy-status"></output></div><div id="retry-normal" hidden><p>成功：窗口已打开</p><a href="/functions/">工具</a></div></section>}
{id==='load'&&<section class="acc-card"><div id="layer-site">网站 Loading</div><div id="layer-app" hidden>应用 Loading</div><div id="layer-component" hidden>组件 Loading</div><div id="layer-shutting" hidden>正在关闭加载动画</div><div id="layer-done" hidden><p>成功：加载结束</p><a href="/functions/">工具</a></div></section>}
{id==='tutorial'&&<section class="acc-card"><button id="tutorial-subject">按钮</button><section id="tutorial"><p id="tutorial-step">这是一个按钮</p><div class="tutorial-mask"></div><button id="tutorial-next">下一步</button><button id="tutorial-skip">跳过教程</button><div id="skip-confirm" hidden><p>确定已经掌握教程内容吗？</p><button id="skip-really">确定跳过</button><button id="skip-return">继续教程</button></div></section><p id="tutorial-complete" hidden>您已掌握基本操作</p><button id="tutorial-again">再来</button></section>}
{id==='achievements'&&<section class="acc-card awards-board"><h2>授勋处</h2><div id="award-list"></div><p>OCV Index <b data-civilization-index>0</b></p><small>100 / legacy limit</small><p>技术栈 <output data-fake-stack>0</output>（内部预设玩笑数据）</p><p id="award-persistence"></p><button id="repeat-three">同一个按钮</button><button class="fake-control" data-fake>假按钮</button><button id="wait-award">等待加载</button><output id="award-wait-status"></output></section>}
{id==='archive'&&<section class="acc-card"><h2>旧仓库</h2><button id="archive-run">发货</button><pre id="archive-result"></pre><button id="metrics-store">登记无意义指标</button><pre id="metrics-result"></pre><label>本地展示配置<input id="local-config-value" type="range" min="0" max="99" value="46"/></label><button id="local-config-set">本地覆盖</button><pre id="configuration-sources"></pre><ul id="shrimp-sort"></ul></section>}
{id==='old'&&<section class="acc-card old-card"><h2>旧版</h2><p>建议使用新版</p><a href="/incidents/intake/">切换新版</a><a href="/functions/">工具</a><nav><button id="old-previous">上一步</button><output id="old-step">1</output><button id="old-next">下一步</button></nav><button id="old-finish">完成</button><p id="old-result"></p></section>}

---
import '../q8/panel.less';
---
<aside class="echo-root q9-resident" data-q8-resident x-data="{fold:false}" hidden>
 <header><button @click="fold=!fold" aria-label="折叠">−</button><button id="echo-language">中 / EN</button><button id="echo-refresh">↻</button></header>
 <div x-show="!fold"><svg class="echo-resident" viewBox="0 0 200 200" aria-label="常驻的小东西"><path d="M48 145Q10 66 64 53L47 7 101 40 150 4 164 73Q197 143 143 173Q83 191 48 145" fill="#dceeff" stroke="#6f9cc7"/><ellipse cx="84" cy="93" rx="9" ry="14" fill="#142e56"/><ellipse cx="136" cy="89" rx="9" ry="14" fill="#142e56"/><path d="M93 127q14 14 29-5" fill="none" stroke="#477098" stroke-width="3"/></svg>
 <p data-echo-talk>回来了。</p><form id="echo-form"><input id="echo-input" maxlength="80" autocomplete="off" placeholder="…" aria-label="对话"/><button type="submit">↵</button></form><div class="echo-quick"><button data-echo-word="你好">你好</button><label>#<input id="echo-color" value="8bb9ef" maxlength="6" aria-label="颜色"/></label><button hx-get="/api/q8/fragment" hx-target="#echo-fragment" hx-swap="innerHTML">▤</button></div><output id="echo-fragment"></output><output data-echo-error role="status"></output><small data-echo-store>本地</small><small data-echo-clock></small></div>
</aside>
<style>.q9-resident{--echo-accent:#8bb9ef;position:fixed;right:9%;bottom:10%;z-index:24030;width:214px;border:1px solid var(--echo-accent);background:#f6fbfff5;box-shadow:0 12px 35px #21447825;color:#244371;font:11px Arial;padding:8px}.q9-resident[hidden]{display:none}.q9-resident header{display:flex;justify-content:flex-end;gap:7px;border-bottom:1px solid #adc5e2}.q9-resident button{color:#164dff;background:#eef6ff;border:1px solid #b4c9e5;padding:3px 5px;font:10px Arial}.q9-resident .echo-resident{width:92px;height:92px;margin:7px auto;transition:filter .3s}.echo-answer{filter:drop-shadow(0 0 9px #64afff);animation:answer .2s 4}.q9-resident input{width:152px;background:white;border:1px solid #9fbde4;padding:4px}.q9-resident .echo-quick{display:flex;gap:4px;margin:7px 0}.q9-resident #echo-color{width:54px;font:9px monospace}.q9-resident output{display:block;overflow-wrap:anywhere}.q9-resident small{margin-right:7px;color:#6a89ad}@keyframes answer{50%{translate:2px -3px}}</style>
<script>if(document.querySelector('[data-q8-resident]'))await import('../q8/echo.mjs');</script>

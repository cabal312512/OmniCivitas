---
// Added above the existing homepage; the previous optical layer remains mounted.
const bits=Array.from({length:100},(_,i)=>(i*13+i*i)%11<5);
---
<canvas id="reactor-field" aria-label="实体金属、折射玻璃与钴蓝能量反应堆"></canvas>
<div class="reactor-overlay">
 <div class="reactor-grid"></div>
 <div class="reactor-guides"><span></span><span></span><span></span><span></span></div>
 <div class="cobalt-slash slash-a"></div><div class="cobalt-slash slash-b"></div>
 <div class="optics-panel circuit-panel">
  <div class="panel-top"><b>01</b><i></i><span>↗</span></div>
  <svg class="circuit-map" viewBox="0 0 220 160" fill="none">
   <g stroke="currentColor" stroke-width="1.2"><path d="M0 28h42l30 30h30m118-18h-40l-24 24h-26M0 120h50l26-26h25m119 32h-30l-32-32h-26M50 0v35l34 35m96-70v35l-35 35M35 160v-22l48-48m95 70v-20l-40-40"/><path d="M89 54h42v42H89zM100 65h20v20h-20z"/></g>
   <g fill="currentColor">{Array.from({length:12},(_,i)=><circle cx={20+i*16} cy={148} r="1.8"/>)}<circle cx="42" cy="28" r="3"/><circle cx="180" cy="40" r="3"/><circle cx="50" cy="120" r="3"/><circle cx="190" cy="126" r="3"/></g>
   <g stroke="#1250ff" stroke-width="3" class="circuit-current"><path d="M0 28h42l30 30h30M220 126h-30l-32-32h-26M50 0v35l34 35"/></g>
  </svg>
  <div class="scope"><svg viewBox="0 0 220 38"><path d="M0 21h28l7-8 5 18 6-30 9 34 8-15h18l5-6 5 14 5-22 7 28 7-14h35l7-15 8 27 8-11h42"/></svg></div>
 </div>
 <div class="optics-panel matrix-panel"><div class="panel-top"><b>02</b><i></i><span>＋</span></div><div class="bit-matrix">{bits.map((lit,i)=><i class:list={{lit}} style={`--index:${i}`} />)}</div><div class="panel-baseline"><span>00</span><span>FF</span></div></div>
 <div class="optics-panel dark-panel"><span class="lens-cross">+</span><div class="radar"><i></i><i></i><i></i><b></b></div><div class="scan-ruler">{Array.from({length:35},(_,i)=><i style={`--index:${i}`} />)}</div></div>
 <div class="optics-panel spectrum-panel"><div class="panel-top"><b>03</b><i></i><span>∿</span></div><div class="spectrum">{Array.from({length:32},(_,i)=><i style={`--index:${i};--bar:${18+(i*27)%80}%`} />)}</div></div>
 <div class="reactor-telemetry"><span>OCV / <b id="reactor-mode">01</b></span><span><i></i> <b id="reactor-draws">—</b></span></div>
 <div class="kinetic-ring"><span>+</span><i></i><span>+</span><i></i></div>
</div>

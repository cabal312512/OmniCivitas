<section class="maze-panel ciallo-panel" data-draggable aria-label="Ciallo 附件">
 <div class="maze-title"><span>附件</span><button data-drag aria-label="移动 Ciallo 窗口">↔</button><button type="button" data-ciallo-close aria-label="关闭 Ciallo 窗口">×</button></div>
 <div class="ciallo-image"><button type="button" data-ciallo-play aria-label="播放 Ciallo 音效"><img src="/forgotten-cache/03.avif" alt="Ciallo" width="148" height="148" loading="lazy" decoding="async"/></button></div>
 <audio data-ciallo-audio src="/forgotten-cache/audio/meguru-ciallo.mp3" preload="none"></audio>
</section>
<style>
 .ciallo-panel{left:7%;top:430px;width:170px;z-index:25}
 .ciallo-panel[hidden]{display:none}
 .ciallo-panel .maze-title{height:29px;padding:3px 6px;gap:5px;flex-wrap:nowrap}
 .ciallo-panel .maze-title span{margin-right:auto}
 .ciallo-image{padding:8px 10px 10px}
 .ciallo-image button{display:block;width:100%;padding:0;border:0;background:transparent;line-height:0;cursor:pointer}
 .ciallo-image img{display:block;width:148px;height:auto;max-width:100%;border-radius:2px;transform:none!important;rotate:0deg!important}
 @media(max-width:700px){.ciallo-panel{left:18px;top:158px}}
</style>
<script>
 const cialloAudio=document.querySelector<HTMLAudioElement>('[data-ciallo-audio]');
 const stopCiallo=()=>{if(cialloAudio){cialloAudio.pause();cialloAudio.currentTime=0;}};
 document.querySelector('[data-ciallo-play]')?.addEventListener('click',()=>{
  if(!cialloAudio)return;
  stopCiallo();
  cialloAudio.loop=false;
  void cialloAudio.play().catch(()=>{});
 });
 document.querySelector('[data-ciallo-close]')?.addEventListener('click',event=>{
  const panel=(event.currentTarget as HTMLElement).closest<HTMLElement>('.ciallo-panel');
  if(panel)panel.hidden=true;
  stopCiallo();
 });
 window.addEventListener('pagehide',stopCiallo);
</script>

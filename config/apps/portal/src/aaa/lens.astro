---
import './1.css';
---
<svg class="loose-cables" aria-hidden="true"><defs><linearGradient id="loose-wire" x2="1" y2="1"><stop stop-color="#0c38ef"/><stop offset=".5" stop-color="#5ecbff"/><stop offset="1" stop-color="#2244f0"/></linearGradient></defs>{Array.from({length:4},()=> <path class="loose-wire"/>)}{Array.from({length:8},()=> <circle class="loose-spark" r="19"/> )}</svg>
<aside class="loose-lens" data-optical-lens aria-label="光学操纵盘">
 <div class="lens-grip" data-lens-grip tabindex="0" role="button" aria-label="移动光学操纵盘"><i></i><i></i><i></i></div>
 <button class="lens-orbit" data-orbit aria-label="拖动旋转三维结构" title="旋转">
  <svg viewBox="0 0 140 140" aria-hidden="true"><defs><radialGradient id="loose-glass"><stop stop-color="#fff" stop-opacity=".08"/><stop offset=".7" stop-color="#69c9ff" stop-opacity=".04"/><stop offset="1" stop-color="#1754ff" stop-opacity=".3"/></radialGradient></defs><circle cx="70" cy="70" r="59" fill="url(#loose-glass)"/><circle class="lens-outer" cx="70" cy="70" r="61"/><circle class="lens-inner" cx="70" cy="70" r="47"/><g class="lens-axis"><ellipse cx="70" cy="70" rx="25" ry="49"/><ellipse cx="70" cy="70" rx="48" ry="18"/><path d="M70 5v19m0 92v19M5 70h19m92 0h19"/></g><path d="M58 70h24M70 58v24"/><circle cx="70" cy="70" r="3"/></svg>
 </button>
 <div class="lens-switches"><button data-optical-pulse aria-label="发射光学脉冲" title="脉冲"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="3"/><path d="M12 1v3m0 16v3M1 12h3m16 0h3"/></svg></button><button data-window-reset aria-label="恢复关闭和移走的窗口" title="恢复窗口"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8a8 8 0 1 1-1 7M5 3v6h6"/></svg></button></div>
</aside>
<button class="loose-rescue" data-window-reset aria-label="恢复所有窗口" title="恢复窗口"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h12v12H4zM8 4h12v12M8 13h5m-2-2 2 2-2 2"/></svg></button>
<script>import './a.js';</script>
